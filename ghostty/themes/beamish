# Beamish — sunlight-friendly light theme for Ghostty
# Paired with Nordish for `theme = light:beamish,dark:nordish`.

background = faf8f3
foreground = 2a2a2a

cursor-color = cc0066

# Selection — warm cream so it doesn't look like a desaturated patch
selection-background = e8e2d5
selection-foreground = 2a2a2a

# Split divider — slightly darker than bg, lifts the seam without shouting
split-divider-color = d4cfc0

# Standard palette (0-15)
# Convention for light themes:
#   0  ("black")        → near-bg     so "set bg black" stays light
#   7  ("white")        → near-fg     so "set fg white" stays dark
#   1-6                 → saturated, dark enough to read on light bg
#   8-15                → "bright" variants that are TRULY brighter
#                         (not darker — the original beamish had this backwards)
palette = 0=#faf8f3
palette = 1=#c0392b
palette = 2=#2e7d32
palette = 3=#b8860b
palette = 4=#1565c0
palette = 5=#7b1fa2
palette = 6=#00838f
palette = 7=#2a2a2a
palette = 8=#5c5c5c
palette = 9=#d32f2f
palette = 10=#388e3c
palette = 11=#a16407
palette = 12=#1976d2
palette = 13=#c2185b
palette = 14=#0097a7
palette = 15=#1a1a1a

# 256-color grayscale ramp (232-255) — LINEAR INVERSION of the default spec.
#
# Default ramp: 232=#080808 (darkest) → 255=#eeeeee (lightest), step 0x0a.
# Designed for dark backgrounds where "dim text" = light-ish gray.
#
# TUIs like Claude Code, fzf, lazygit, etc. pick a gray index expecting it to
# be dim-on-dark — e.g. `\e[38;5;245m`. On our light bg those same indices
# become invisible. Inverting makes 245 a readable dark gray instead.
#
# Color cube (16-231) is left alone — inverting it would break colored output.
palette = 232=#eeeeee
palette = 233=#e4e4e4
palette = 234=#dadada
palette = 235=#d0d0d0
palette = 236=#c6c6c6
palette = 237=#bcbcbc
palette = 238=#b2b2b2
palette = 239=#a8a8a8
palette = 240=#9e9e9e
palette = 241=#949494
palette = 242=#8a8a8a
palette = 243=#808080
palette = 244=#767676
palette = 245=#6c6c6c
palette = 246=#626262
palette = 247=#585858
palette = 248=#4e4e4e
palette = 249=#444444
palette = 250=#3a3a3a
palette = 251=#303030
palette = 252=#262626
palette = 253=#1c1c1c
palette = 254=#121212
palette = 255=#080808
